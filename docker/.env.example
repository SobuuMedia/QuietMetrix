# QuietMetrix Docker Compose environment.
# Copy to the repo root as `.env` and fill in strong secrets:
#   cp docker/.env.example .env
# Never commit `.env` to version control.

# Postgres password (shared by the postgres, migrate, and ktor services).
QM_DB_PASSWORD=changeme-strong-db-password

# JWT signing secret. Generate with: openssl rand -hex 32
QM_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# Comma-separated origins allowed to call the API from a browser.
# Defaults to http://localhost:8080 (the dashboard's own origin) if unset.
QM_CORS_ALLOWED_ORIGINS=http://localhost:8080
