# QuietMetrix Docker Compose environment.
# Copy to the repo root as `.env` and fill in strong secrets:
#   cp docker/.env.example .env
# Never commit `.env` to version control.

# Postgres password (shared by the postgres, migrate, and ktor services).
QM_DB_PASSWORD=changeme-strong-db-password

# JWT signing secret. Generate with: openssl rand -hex 32
QM_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# Comma-separated origins allowed to call the API from a browser.
# Defaults to http://localhost:8080 (the dashboard's own origin) if unset.
QM_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Initial admin account, seeded on first run. Log in with these at /dashboard/.
QM_ADMIN_EMAIL=admin@example.com
QM_ADMIN_PASSWORD=changeme-admin-password

# Local development remains private to this machine.
QM_BIND_ADDRESS=127.0.0.1
QM_HTTP_PORT=8080
QM_PROFILE=selfhost
QM_PUBLIC_ORIGIN=http://localhost:8080
# Empty uses hosted plan retention, or unlimited in self-host mode.
QM_RETENTION_DAYS=
# Empty uses 10,000 requests/project/day in cloud, unlimited in self-host mode.
QM_COUNTER_REQUESTS_PER_DAY=
QM_TRUSTED_PROXIES=

# Production override only: publicly owned DNS name and certificate contact.
# QM_DOMAIN=analytics.example.com
# QM_TLS_EMAIL=ops@example.com
