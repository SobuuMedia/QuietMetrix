{
  "info": {
    "name": "QuietMetrix aggregate API contract",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "REQUIRED_DISPOSABLE_PROJECT_KEY"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('day', new Date().toISOString().slice(0,10));",
          "if (!pm.collectionVariables.get('batchId')) pm.collectionVariables.set('batchId', 'contract_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g,''));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "url": "{{base}}/api/v1/health",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Protected projects reject anonymous requests",
      "request": {
        "method": "GET",
        "url": "{{base}}/api/v1/projects",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Capabilities require a project key",
      "request": {
        "method": "GET",
        "url": "{{base}}/api/v1/sdk/capabilities",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Schema-2 ingest requires a project key",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v2/counters",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"schema\": 2, \"batch_id\": \"contract_batch_0001\", \"sdk\": {\"platform\": \"web\", \"version\": \"0.6.0\"}, \"items\": []}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Legacy ingest requires a project key",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v1/counters",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"day\": \"{{day}}\", \"counters\": []}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Schema-2 aggregate ingestion",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v2/counters",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-QM-Api-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"schema\": 2, \"batch_id\": \"{{batchId}}\", \"sdk\": {\"platform\": \"web\", \"version\": \"0.6.0\"}, \"items\": [{\"day\": \"{{day}}\", \"hour\": null, \"metric\": \"event_v2\", \"segment\": {\"kind\": \"global\", \"value\": \"all\"}, \"dimensions\": {\"name\": \"contract_open\"}, \"n\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 202', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "Same receipt retries successfully",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/v2/counters",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-QM-Api-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"schema\": 2, \"batch_id\": \"{{batchId}}\", \"sdk\": {\"platform\": \"web\", \"version\": \"0.6.0\"}, \"items\": [{\"day\": \"{{day}}\", \"hour\": null, \"metric\": \"event_v2\", \"segment\": {\"kind\": \"global\", \"value\": \"all\"}, \"dimensions\": {\"name\": \"contract_open\"}, \"n\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 202', () => pm.response.to.have.status(202));",
              "pm.test('Retry is deduplicated', () => pm.expect(pm.response.json().replayed).to.be.true);"
            ]
          }
        }
      ]
    }
  ]
}
