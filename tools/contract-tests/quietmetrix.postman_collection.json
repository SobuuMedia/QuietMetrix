    {
      "name": "Projects via Personal Access Token",
      "item": [
        {
          "name": "POST /projects with a bogus qm_pat_ token returns 401",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/v1/projects",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer qm_pat_contract_test_invalid" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Contract Test App\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /projects without auth returns 401",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/v1/projects",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Contract Test App\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "base", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "qm_ak_test_key_replace_me" }
  ]
}